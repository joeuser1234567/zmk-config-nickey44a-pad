#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define NUMBERS 2
#define SYMBOLS 3
#define EXTRA 4
#define BLUETOOTH 5

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        select_bt: select_bt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>,
                       <&bluetooth_off BLUETOOTH>;
        };
    };

    behaviors {
        bluetooth_off: bluetooth_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_default_layer {
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E  &kp R         &kp T                                                    &kp Y            &kp U            &kp I      &kp O    &kp P             &kp LANGUAGE_1
&kp GRAVE   &kp A  &kp S  &kp D  &kp F         &kp G                                                    &kp H            &kp J            &kp K      &kp L    &kp MINUS         &kp LANGUAGE_2
&kp LSHFT   &kp Z  &kp X  &kp C  &kp V         &kp B             &trans                    &trans       &kp N            &kp M            &kp COMMA  &kp DOT  &kp SINGLE_QUOTE  &mt RSHIFT SLASH
                                 &kp LEFT_ALT  &mt LEFT_ALT TAB  &mt LEFT_GUI SPACE        &lt NUMBERS ENTER  &lt SYMBOLS BACKSPACE  &lt EXTRA RIGHT_ALT
            >;
        };

        windows_default: windows_default_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans                &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &mt LEFT_GUI TAB  &mt LEFT_CONTROL SPACE    &trans  &trans  &trans
            >;
        };

        numbers_layer {
            bindings = <
&trans  &kp PLUS      &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                    &kp F2          &kp F3          &kp F12          &trans  &trans  &trans
&trans  &kp ASTERISK  &kp SLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6                    &trans          &kp UP_ARROW    &trans           &trans  &trans  &trans
&trans  &kp EQUAL     &trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &tog BLUETOOTH
                                               &kp NUMBER_0  &kp PERIOD    &trans    &trans  &kp DELETE      &trans
            >;
        };

        symbols_layer {
            bindings = <
&trans &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR    &kp PERCENT                     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp EQUAL         &kp PLUS           &trans
&trans &kp CARET        &kp AMPERSAND  &kp ASTERISK  &trans        &trans                          &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON      &trans            &kp UNDERSCORE     &trans
&trans &kp GRAVE        &kp TILDE      &kp PIPE      &kp QUESTION  &trans        &trans    &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp BACKSLASH
                                                            &trans       &trans  &trans    &trans  &trans                &trans
            >;
        };

        extra_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &studio_unlock                    &select_bt 0  &select_bt 1    &select_bt 2  &select_bt 3  &select_bt 4  &trans
&trans  &trans  &trans  &trans  &trans  &trans                            &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans  &trans        &trans          &trans        &trans        &trans        &bluetooth_off BLUETOOTH
                                &trans  &trans          &trans    &trans  &trans        &trans
            >;
        };
    };
};
